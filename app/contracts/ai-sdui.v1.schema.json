{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planning-harness.local/contracts/ai-sdui.v1.schema.json",
  "title": "Planning Harness provider-independent AI SDUI result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "generated_at", "source", "card"],
  "properties": {
    "schema": { "const": "planning-harness.ai-sdui.v1" },
    "result_id": { "$ref": "#/$defs/id" },
    "generated_at": { "$ref": "#/$defs/dateTime" },
    "source": { "$ref": "#/$defs/source" },
    "card": { "$ref": "#/$defs/aiResultCard" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "provider": {
      "enum": ["claude", "codex", "copilot", "other"]
    },
    "queueStatus": {
      "enum": ["pending", "running", "completed", "failed", "blocked"]
    },
    "componentType": {
      "enum": [
        "aiResultCard",
        "textBlock",
        "metricCard",
        "statusBadge",
        "approvalCard",
        "actionGroup"
      ]
    },
    "actionType": {
      "enum": [
        "OPEN_REQUIREMENTS",
        "OPEN_EVIDENCE",
        "OPEN_JOB",
        "OPEN_ARTIFACT",
        "ENQUEUE_ANALYSIS",
        "ENQUEUE_RETRY",
        "APPROVE_JOB",
        "MODIFY_CODE",
        "PUSH_CHANGES",
        "DEPLOY",
        "DELETE_RESOURCE"
      ]
    },
    "riskyOperation": {
      "enum": ["MODIFY_CODE", "PUSH_CHANGES", "DEPLOY", "DELETE_RESOURCE"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "referenceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "ref_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "OPEN_REQUIREMENTS",
            "OPEN_EVIDENCE",
            "OPEN_JOB",
            "OPEN_ARTIFACT",
            "ENQUEUE_ANALYSIS",
            "ENQUEUE_RETRY"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ref_id": { "$ref": "#/$defs/id" }
      }
    },
    "approveAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "job_id", "operation", "payload_hash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "APPROVE_JOB" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "job_id": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/riskyOperation" },
        "payload_hash": { "$ref": "#/$defs/payloadHash" }
      }
    },
    "safeAction": {
      "oneOf": [
        { "$ref": "#/$defs/referenceAction" },
        { "$ref": "#/$defs/approveAction" }
      ]
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "textBlock" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      }
    },
    "metricCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "metricCard" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "value"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 120 },
            "value": { "type": "string", "minLength": 1, "maxLength": 200 },
            "unit": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      }
    },
    "statusBadge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "statusBadge" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "$ref": "#/$defs/queueStatus" },
            "label": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    },
    "actionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "actionGroup" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/referenceAction" }
        }
      }
    },
    "approvalCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "approvalCard" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "job_id",
            "operation",
            "payload_hash",
            "dry_run",
            "server_check_required",
            "expires_at"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "job_id": { "$ref": "#/$defs/id" },
            "operation": { "$ref": "#/$defs/riskyOperation" },
            "payload_hash": { "$ref": "#/$defs/payloadHash" },
            "dry_run": { "const": true },
            "server_check_required": { "const": true },
            "expires_at": { "$ref": "#/$defs/dateTime" }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/approveAction" }
        }
      }
    },
    "childComponent": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/metricCard" },
        { "$ref": "#/$defs/statusBadge" },
        { "$ref": "#/$defs/actionGroup" },
        { "$ref": "#/$defs/approvalCard" }
      ]
    },
    "aiResultCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props", "children", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "aiResultCard" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "summary", "status"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "status": { "$ref": "#/$defs/queueStatus" }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/childComponent" }
        },
        "actions": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/referenceAction" }
        }
      }
    }
  }
}
